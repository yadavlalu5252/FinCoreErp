@model FinCoreErp.DTO.Asset.AssetEditDto

@{
    ViewData["Title"] = "Edit Asset";
}

<div class="container-fluid">

    <h2 class="mb-4">Edit Asset</h2>

    <div class="card">
        <div class="card-body">

            <form asp-controller="Asset"
                  asp-action="Edit"
                  method="post">

                <input asp-for="AssetId" type="hidden" />

                <div class="row">

                    <!-- Asset Code -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="AssetCode" class="form-label">
                            Asset Code
                        </label>

                        <input asp-for="AssetCode"
                               class="form-control"
                               placeholder="Enter Asset Code" />

                        <span asp-validation-for="AssetCode"
                              class="text-danger">
                        </span>
                    </div>


                    <!-- Asset Name -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="AssetName" class="form-label">
                            Asset Name
                        </label>

                        <input asp-for="AssetName"
                               class="form-control"
                               placeholder="Enter Asset Name" />

                        <span asp-validation-for="AssetName"
                              class="text-danger">
                        </span>
                    </div>


                    <!-- Vendor -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="VendorId" class="form-label">
                            Vendor
                        </label>

                        <select asp-for="VendorId"
                                asp-items="ViewBag.Vendors"
                                class="form-control">

                            <option value="">
                                Select Vendor
                            </option>

                        </select>
                    </div>


                    <!-- Department -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="DepartmentId" class="form-label">
                            Department
                        </label>

                        <select asp-for="DepartmentId"
                                asp-items="ViewBag.Departments"
                                class="form-control">

                            <option value="">
                                Select Department
                            </option>

                        </select>
                    </div>


                    <!-- CAPEX Request -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="CapexRequestId" class="form-label">
                            CAPEX Request
                        </label>

                        <select asp-for="CapexRequestId"
                                asp-items="ViewBag.CapexRequests"
                                class="form-control">

                            <option value="">
                                Select CAPEX Request
                            </option>

                        </select>
                    </div>


                    <!-- Purchase Order -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="PurchaseOrderId" class="form-label">
                            Purchase Order
                        </label>

                        <select asp-for="PurchaseOrderId"
                                asp-items="ViewBag.PurchaseOrders"
                                class="form-control">

                            <option value="">
                                Select Purchase Order
                            </option>

                        </select>
                    </div>


                    <!-- GRN -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="GRNId" class="form-label">
                            GRN
                        </label>

                        <select asp-for="GRNId"
                                asp-items="ViewBag.GRNs"
                                class="form-control">

                            <option value="">
                                Select GRN
                            </option>

                        </select>
                    </div>


                    <!-- Purchase Date -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="PurchaseDate" class="form-label">
                            Purchase Date
                        </label>

                        <input asp-for="PurchaseDate"
                               type="date"
                               class="form-control" />
                    </div>


                    <!-- Purchase Cost -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="PurchaseCost" class="form-label">
                            Purchase Cost
                        </label>

                        <input asp-for="PurchaseCost"
                               type="number"
                               step="0.01"
                               class="form-control"
                               placeholder="Enter Purchase Cost" />
                    </div>


                    <!-- Status -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Status" class="form-label">
                            Status
                        </label>

                        <select asp-for="Status"
                                asp-items="ViewBag.Status"
                                class="form-control">

                            <option value="">
                                Select Status
                            </option>

                        </select>
                    </div>

                </div>


                <!-- Buttons -->
                <div class="mt-3">

                    <button type="submit"
                            class="btn btn-primary">
                        Update Asset
                    </button>

                    <a asp-controller="AssetList"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}