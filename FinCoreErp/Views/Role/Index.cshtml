@{
    ViewData["Title"] = "Role";
    Layout = "_AdminLayout";

}


<a id="btn" class="btn btn-primary text-white">Add Role</a>

<table class="table">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Role Name</th>
            <th scope="col">Description</th>
            <th scope="col">Status</th>
            <th scope="col">Action</th>
        </tr>
    </thead>
    <tbody id="roledata">
    </tbody>
</table>



<!-- Modal -->
<div class="modal fade" id="roleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Add Role</h5>
                <button type="button" class="close" id="closemodal" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <form id="roleform" method="post">
                    <input type="hidden" name="RoleId" id="RoleId" />
                    Role Name<input type="text" name="RoleName" class="form-control" />
                    Description<input type="text" name="Description" class="form-control" />
                    
                    Status
                    <select name="IsActive" class="form-control">
                        <option value="1">Active</option>
                        <option value="0">Inactive</option>
                    </select>

                    <input type="submit" value="Save" id="savebtn" class="btn btn-primary" />

                </form>
            </div>
        </div>
    </div>
</div>


<!-- Update Role Modal -->
<div class="modal fade" id="updateRoleModal" tabindex="-1" role="dialog">

    <div class="modal-dialog" role="document">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">Update Role</h5>

                <button type="button"
                        class="close"
                        id="closeUpdateModal"
                        data-dismiss="modal">

                    <span>&times;</span>

                </button>

            </div>

            <div class="modal-body">

                <form id="updateRoleForm" method="post">

                    <input type="hidden"
                           name="RoleId"
                           id="UpdateRoleId" />

                    Role Name
                    <input type="text"
                           name="RoleName"
                           id="UpdateRoleName"
                           class="form-control" />

                    <br />

                    Description
                    <input type="text"
                           name="Description"
                           id="UpdateDescription"
                           class="form-control" />

                    <br />

                    Status

                    <select name="IsActive"
                            id="UpdateIsActive"
                            class="form-control">

                        <option value="1">Active</option>
                        <option value="0">Inactive</option>

                    </select>

                    <br />

                    <input type="submit"
                           value="Update"
                           id="updatebtn"
                           class="btn btn-success" />

                </form>

            </div>

        </div>

    </div>

</div>

