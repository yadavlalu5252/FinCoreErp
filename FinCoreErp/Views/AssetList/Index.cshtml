@model List<FinCoreErp.DTO.Asset.AssetListDto>

@{
    ViewData["Title"] = "Asset List";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Asset List</h2>

        <a asp-controller="AssetRegister"
           asp-action="Index"
           class="btn btn-primary">
            Register Asset
        </a>
    </div>

    <div class="card">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-striped">

                    <thead>
                        <tr>
                            <th>Asset Code</th>
                            <th>Asset Name</th>
                            <th>Vendor</th>
                            <th>Department</th>
                            <th>Purchase Date</th>
                            <th>Purchase Cost</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var asset in Model)
                            {
                                <tr>
                                    <td>@asset.AssetCode</td>

                                    <td>@asset.AssetName</td>

                                    <td>@asset.VendorCode</td>

                                    <td>@asset.DepartmentName</td>

                                    <td>
                                        @(asset.PurchaseDate?.ToString("dd-MM-yyyy") ?? "-")
                                    </td>

                                    <td>
                                        @(asset.PurchaseCost?.ToString("N2") ?? "-")
                                    </td>

                                    <td>@asset.Status</td>

                                 <td>
    <a asp-controller="Asset"
       asp-action="Details"
       asp-route-id="@asset.AssetId"
       class="btn btn-sm btn-info">
        View
    </a>

    <a asp-controller="Asset"
       asp-action="Edit"
       asp-route-id="@asset.AssetId"
       class="btn btn-sm btn-warning">
        Edit
    </a>

    <a asp-controller="Asset"
       asp-action="Delete"
       asp-route-id="@asset.AssetId"
       class="btn btn-sm btn-danger"
       onclick="return confirm('Are you sure you want to delete this asset?');">
        Delete
    </a>

    @if (asset.Status != "Disposed")
    {
        <a asp-controller="AssetDisposal"
           asp-action="Index"
           asp-route-id="@asset.AssetId"
           class="btn btn-sm btn-secondary">
            Dispose
        </a>
    }
</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center">
                                    No assets found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>